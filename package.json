{
  "name": "simcaster",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wrangler dev --port 8787\"",
    "build": "vite build",
    "preview": "vite build && wrangler dev --port 8787",
    "assets": "node scripts/build-assets.mjs",
    "db:local": "wrangler d1 migrations apply simcaster --local",
    "db:remote": "wrangler d1 migrations apply simcaster --remote",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@farcaster/auth-client": "^0.7.1",
    "@react-three/fiber": "^9.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "viem": "^2.24.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.20.0"
  }
}
