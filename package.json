{
  "name": "simcaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"node --env-file-if-exists=.env --watch server/index.js\"",
    "build": "npm run build:app",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "build:app": "vite build"
  },
  "dependencies": {
    "@farcaster/auth-client": "^0.7.1",
    "@farcaster/auth-kit": "^0.8.2",
    "@react-three/fiber": "^9.1.2",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "viem": "^2.24.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.2.0"
  }
}
