# Copy to .env (never commit secrets).
PORT=3001
APP_ORIGIN=http://localhost:5173
# Only turn on locally or in a private demo. DO NOT enable in production.
SIMCASTER_DEMO_MODE=true
# Optional, needed for live Farcaster feeds and profile hydration.
NEYNAR_API_KEY=
# Optional public Neynar application Client ID for consent-based in-app writes.
# Configure https://simcaster-world.onrender.com as an authorized origin in Neynar.
NEYNAR_CLIENT_ID=
# Farcaster Auth SIWF signature validation RPC
OPTIMISM_RPC_URL=https://mainnet.optimism.io
# Persistent single-instance local data. Replace with Postgres for multi-instance production.
DATA_FILE=.data/simcaster.json
