{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simcaster",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "d1_databases": [
    // Dedicated production D1 database for the simcaster Worker.
    { "binding": "DB", "database_name": "simcaster", "database_id": "55040268-610a-43a9-bc49-062ac34ed1fe", "migrations_dir": "migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // "true" enables name-only demo sign-in. Leave "false" in production.
    "DEMO_MODE": "false",
    "OPTIMISM_RPC_URL": "https://mainnet.optimism.io"
  },
  "observability": { "enabled": true }
}
